# Supabase project settings (Dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service-role key — server-only, NEVER exposed to the browser. Used by
# app/api/admin/* routes to create/remove admin accounts. Keep this secret.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Paystack (checkout)
PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Order notification email (sent on successful payment webhook)
RESEND_API_KEY=
YOUR_EMAIL=
