# Supabase project settings (Dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service-role key — server-only, NEVER exposed to the browser. Used by
# app/api/admin/* routes to create/remove admin accounts. Keep this secret.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Squad (card/bank/USSD checkout) — Dashboard → Settings → API Keys.
# Leave SQUAD_SECRET_KEY unset and checkout just falls back to bank transfer.
SQUAD_SECRET_KEY=
SQUAD_ENV=sandbox
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Paystack (dormant — not wired to any button currently, kept for later)
PAYSTACK_SECRET_KEY=

# Order notification email (sent on successful payment webhook)
RESEND_API_KEY=
YOUR_EMAIL=
